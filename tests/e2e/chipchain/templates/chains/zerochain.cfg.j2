# Zerochain configuration for ChipChain consensus
# Zerochain uses ChipChain consensus instead of DAG-PoA

[chain]
id=0x0000000000000000
shard_id=0x0000000000000000
name=zerochain
load_priority=0
datum_types=[token,emission,ca,decree]
default_datum_types=[token,emission,ca,decree]
mempool_auto_types=[token,emission,ca,decree]
consensus=chipchain
{% if authorized_nodes_addrs %}
authorized_nodes_addrs={{ authorized_nodes_addrs }}
{% endif %}

[files]
storage_dir=../../../var/lib/network/{{ network_name | default('stagenet') }}/zerochain/

[blocks]
is_celled=false
is_static_genesis_block={{ is_static_genesis_block | default('false', true) }}
static_genesis_block={{ static_genesis_block | default('', true) }}

[chipchain]
consensus_debug={{ consensus_debug | default('true', true) }}
min_validators_count={{ min_validators_count | default(3, true) }}
# Floor for verifying sealed seed blocks when min_validators_count is raised later
bootstrap_min_validators_count={{ bootstrap_min_validators_count | default(min_validators_count | default(3, true), true) }}
{% if auth_certs_count %}
auth_certs_count={{ auth_certs_count }}
{% endif %}
{% if validators_addrs and validators_addrs != '[]' -%}
validators_addrs={{ validators_addrs }}
{% endif -%}
poa_mode={{ poa_mode | default('true', true) }}
auth_certs_prefix={{ network_name | default('stagenet') }}.root
{% if blocks_sign_cert %}
blocks-sign-cert={{ blocks_sign_cert }}
{% elif events_sign_cert %}
blocks-sign-cert={{ events_sign_cert }}
{% endif %}
{% if fee_addr -%}
fee_addr={{ fee_addr }}
{% endif -%}
new_round_delay={{ new_round_delay | default(15, true) }}
round_start_sync_timeout={{ round_start_sync_timeout | default(5, true) }}
round_attempts_max={{ round_attempts_max | default(3, true) }}
round_attempt_timeout={{ round_attempt_timeout | default(10, true) }}
# ChipChain-specific: Chipmunk aggregated signatures
use_chipmunk_aggregated={{ use_chipmunk_aggregated | default('false', true) }}
# ChipChain-specific: auto-sharding (0 = disabled)
cell_size_threshold={{ cell_size_threshold | default(0, true) }}
